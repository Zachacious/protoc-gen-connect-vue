{
  "name": "@zachacious/protoc-gen-connect-vue",
  "version": "1.0.21",
  "description": "Type-safe Vue 3 SDK generator for ConnectRPC with TanStack Query hooks",
  "keywords": [
    "protoc",
    "protoc-plugin",
    "protobuf",
    "connectrpc",
    "connect-rpc",
    "grpc",
    "grpc-web",
    "vue",
    "vue3",
    "vue-query",
    "tanstack-query",
    "codegen",
    "sdk-generator",
    "typescript",
    "buf"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Zachacious",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachacious/protoc-gen-connect-vue.git"
  },
  "bugs": {
    "url": "https://github.com/zachacious/protoc-gen-connect-vue/issues"
  },
  "homepage": "https://github.com/zachacious/protoc-gen-connect-vue#readme",
  "main": "dist/generator.js",
  "bin": {
    "protoc-gen-connect-vue": "bin/protoc-gen-connect-vue"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/generator.ts --outdir ./dist --target node --bundle",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@bufbuild/protoplugin": "^2.10.2",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
