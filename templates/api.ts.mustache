export const useApi = () => {
  const { client } = useGrpcClient();
  const queryClient = useQueryClient();

  const isFetching = useIsFetching();
  const isMutating = useIsMutating();
  const isGlobalLoading = computed(() => isFetching.value > 0 || isMutating.value > 0);

  {{#rpcs}}
  {{> rpc}}
  {{/rpcs}}

  return {
    {{#rpcs}}
    {{functionName}},
    {{hookName}},
    {{/rpcs}}
    isGlobalLoading,
    queryKeys,
    createEmpty
  };
};